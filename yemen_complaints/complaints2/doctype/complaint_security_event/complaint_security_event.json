    {"fieldname":"status","fieldtype":"Select","label":"Status","options":"Allowed\nBlocked\nObserved","default":"Observed","in_list_view":1},
    {"fieldname":"endpoint","fieldtype":"Data","label":"Endpoint","in_list_view":1},
    {"fieldname":"scope","fieldtype":"Data","label":"Scope","in_list_view":1},
