    {"fieldname":"occurred_on","fieldtype":"Datetime","label":"Occurred On","in_list_view":1},
    {"fieldname":"message","fieldtype":"Small Text","label":"Message"},
    {"fieldname":"metadata_json","fieldtype":"Code","label":"Metadata JSON","options":"JSON"}
