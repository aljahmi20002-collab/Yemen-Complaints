{
  "doctype": "DocType",
  "engine": "InnoDB",
  "module": "Complaints2",
  "name": "Complaint Security Event",
  "field_order": [
    "event_type",
    "severity",
    "status",
    "endpoint",
    "scope",
    "identifier",
    "ip_address",
    "user",
    "occurred_on",
