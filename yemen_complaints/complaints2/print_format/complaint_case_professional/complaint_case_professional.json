 "html": "{% from \"yemen_complaints/templates/includes/print_macros.html\" import cell %}\n<div class=\"yc-print-shell\" style=\"direction:rtl;font-family:'DroidArabicKufi',Tahoma,Arial,sans-serif;padding:18px;background:#fff;color:#111827;\">\n  <div style=\"border:1px solid #e5e7eb;border-radius:22px;overflow:hidden;\">\n    <div style=\"background:linear-gradient(135deg,#9b1c1c,#c2410c);color:#fff;padding:24px 24px 18px;\">\n      <table width=\"100%\" style=\"border:none;\">\n        <tr>\n          <td style=\"border:none;vertical-align:top;\">\n            <div style=\"font-size:26px;font-weight:800;\">\u0633\u062c\u0644 \u0627\u0644\u0634\u0643\u0648\u0649 / \u0627\u0644\u062a\u0638\u0644\u0645</div>\n            <div style=\"font-size:13px;opacity:.92;margin-top:6px;\">\u0645\u0646\u0635\u0629 \u0627\u0644\u064a\u0645\u0646 \u0644\u0644\u0634\u0643\u0627\u0648\u0649 \u0648\u0627\u0644\u062a\u0638\u0644\u0645\u0627\u062a - \u0646\u0633\u062e\u0629 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0637\u0628\u0627\u0639\u0629</div>\n          </td>\n          <td style=\"border:none;text-align:left;vertical-align:top;\">\n            <div style=\"display:inline-block;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);padding:10px 14px;border-radius:14px;min-width:210px;\">\n              <div style=\"font-size:12px;opacity:.88;\">\u0631\u0642\u0645 \u0627\u0644\u062d\u0627\u0644\u0629</div>\n              <div style=\"font-size:21px;font-weight:800;\">{{ doc.name }}</div>\n              <div style=\"font-size:12px;margin-top:4px;\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0637\u0628\u0627\u0639\u0629: {{ frappe.utils.formatdate(frappe.utils.nowdate()) }}</div>\n            </div>\n          </td>\n        </tr>\n      </table>\n      <div style=\"margin-top:16px;display:flex;gap:8px;flex-wrap:wrap;\">\n        <span style=\"background:rgba(255,255,255,.14);padding:6px 12px;border-radius:999px;font-size:12px;font-weight:700;\">{{ doc.case_type }}</span>\n        <span style=\"background:rgba(255,255,255,.14);padding:6px 12px;border-radius:999px;font-size:12px;font-weight:700;\">{{ doc.status }}</span>\n        <span style=\"background:rgba(255,255,255,.14);padding:6px 12px;border-radius:999px;font-size:12px;font-weight:700;\">{{ doc.priority }}</span>\n        <span style=\"background:rgba(255,255,255,.14);padding:6px 12px;border-radius:999px;font-size:12px;font-weight:700;\">{{ doc.government_entity or '\u0628\u062f\u0648\u0646 \u062c\u0647\u0629' }}</span>\n      </div>\n    </div>\n\n    <div style=\"padding:18px 18px 22px;background:#fff;\">\n      <div style=\"font-size:16px;font-weight:800;color:#9b1c1c;margin-bottom:10px;\">\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0648\u0627\u0637\u0646</div>\n      <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:10px;\">\n        {{ cell('\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0631\u0628\u0627\u0639\u064a', doc.citizen_full_name) }}\n        {{ cell('\u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0648\u0637\u0646\u064a', doc.citizen_national_id) }}\n        {{ cell('\u0631\u0642\u0645 \u0627\u0644\u062c\u0648\u0627\u0632', doc.passport_number) }}\n        {{ cell('\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641', doc.mobile_number) }}\n        {{ cell('\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a', doc.email) }}\n        {{ cell('\u0627\u0644\u062f\u0648\u0644\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629', doc.current_country) }}\n        {{ cell('\u0627\u0644\u0645\u062d\u0627\u0641\u0638\u0629', doc.citizen_governorate) }}\n        {{ cell('\u0627\u0644\u0645\u062f\u064a\u0631\u064a\u0629', doc.citizen_district) }}\n      </div>\n\n      <div style=\"font-size:16px;font-weight:800;color:#9b1c1c;margin:18px 0 10px;\">\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0637\u0644\u0628</div>\n      <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:10px;\">\n        {{ cell('\u0627\u0644\u062a\u0635\u0646\u064a\u0641', doc.category) }}\n        {{ cell('\u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u0645\u0639\u0646\u064a\u0629', doc.government_entity) }}\n        {{ cell('\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0648\u0627\u0642\u0639\u0629', frappe.format(doc.incident_date, {'fieldtype': 'Date'}) if doc.incident_date else '\u2014') }}\n        {{ cell('\u0645\u062d\u0627\u0641\u0638\u0629 \u0627\u0644\u0648\u0627\u0642\u0639\u0629', doc.incident_governorate) }}\n        {{ cell('\u0645\u062f\u064a\u0631\u064a\u0629 \u0627\u0644\u0648\u0627\u0642\u0639\u0629', doc.incident_district) }}\n        {{ cell('\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0645\u0641\u0636\u0644\u0629', doc.preferred_language) }}\n        {{ cell('\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0633\u0631\u064a\u0629', doc.confidentiality_level) }}\n        {{ cell('\u0627\u0644\u0645\u0648\u0638\u0641 \u0623\u0648 \u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u0645\u062d\u0644 \u0627\u0644\u0634\u0643\u0648\u0649', doc.against_employee) }}\n      </div>\n\n      <div style=\"margin-top:18px;padding:16px;border:1px solid #e5e7eb;border-radius:16px;background:#fafafa;\">\n        <div style=\"font-size:15px;font-weight:800;margin-bottom:8px;color:#9b1c1c;\">\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0645\u0648\u0636\u0648\u0639</div>\n        <div style=\"font-size:15px;font-weight:700;\">{{ doc.subject }}</div>\n      </div>\n\n      <div style=\"margin-top:12px;padding:16px;border:1px solid #e5e7eb;border-radius:16px;background:#fff;\">\n        <div style=\"font-size:15px;font-weight:800;margin-bottom:10px;color:#9b1c1c;\">\u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644</div>\n        <div style=\"line-height:2;font-size:13px;\">{{ doc.details or '' }}</div>\n      </div>\n\n      {% if doc.grievance_reason %}\n      <div style=\"margin-top:12px;padding:16px;border:1px solid #fde68a;border-radius:16px;background:#fffbeb;\">\n        <div style=\"font-size:15px;font-weight:800;margin-bottom:10px;color:#92400e;\">\u0633\u0628\u0628 \u0627\u0644\u062a\u0638\u0644\u0645</div>\n        <div style=\"line-height:1.9;font-size:13px;\">{{ doc.grievance_reason }}</div>\n      </div>\n      {% endif %}\n\n      <div style=\"font-size:16px;font-weight:800;color:#9b1c1c;margin:18px 0 10px;\">\u0627\u0644\u0645\u0633\u0627\u0631 \u0627\u0644\u0632\u0645\u0646\u064a \u0648\u0627\u0644\u062a\u0643\u0644\u064a\u0641\u0627\u062a</div>\n      <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:10px;\">\n        {{ cell('\u0627\u0644\u0645\u0633\u062a\u0634\u0627\u0631', doc.advisor_user) }}\n        {{ cell('\u0645\u0648\u0638\u0641 \u0627\u0644\u062c\u0647\u0629', doc.agency_officer_user) }}\n        {{ cell('\u0627\u0644\u0645\u062a\u0627\u0628\u0639', doc.follow_up_user) }}\n        {{ cell('\u0645\u0648\u0639\u062f \u0623\u0648\u0644 \u0631\u062f', frappe.format(doc.target_response_on, {'fieldtype': 'Datetime'}) if doc.target_response_on else '\u2014') }}\n        {{ cell('\u0645\u0648\u0639\u062f \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0645\u0633\u062a\u0647\u062f\u0641', frappe.format(doc.target_resolution_date, {'fieldtype': 'Date'}) if doc.target_resolution_date else '\u2014') }}\n        {{ cell('\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062d\u0633\u0645', frappe.format(doc.resolved_on, {'fieldtype': 'Datetime'}) if doc.resolved_on else '\u2014') }}\n      </div>\n\n      {% if doc.get('assignments') %}\n      <div style=\"margin-top:14px;border:1px solid #e5e7eb;border-radius:16px;overflow:hidden;\">\n        <div style=\"background:#f8fafc;padding:12px 14px;font-weight:800;color:#0f172a;\">\u0633\u062c\u0644 \u0627\u0644\u0625\u062d\u0627\u0644\u0627\u062a</div>\n        <table width=\"100%\" style=\"border-collapse:collapse;\">\n          <thead>\n            <tr style=\"background:#fff7ed;\">\n              <th style=\"padding:10px;border-bottom:1px solid #e5e7eb;text-align:right;\">\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645</th>\n              <th style=\"padding:10px;border-bottom:1px solid #e5e7eb;text-align:right;\">\u0627\u0644\u062f\u0648\u0631</th>\n              <th style=\"padding:10px;border-bottom:1px solid #e5e7eb;text-align:right;\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u062d\u0627\u0644\u0629</th>\n              <th style=\"padding:10px;border-bottom:1px solid #e5e7eb;text-align:right;\">\u0627\u0644\u0627\u0633\u062a\u062d\u0642\u0627\u0642</th>\n              <th style=\"padding:10px;border-bottom:1px solid #e5e7eb;text-align:right;\">\u0627\u0644\u062d\u0627\u0644\u0629</th>\n            </tr>\n          </thead>\n          <tbody>\n            {% for row in doc.assignments %}\n            <tr>\n              <td style=\"padding:10px;border-bottom:1px solid #f1f5f9;\">{{ row.assigned_to or '\u2014' }}</td>\n              <td style=\"padding:10px;border-bottom:1px solid #f1f5f9;\">{{ row.role_type or '\u2014' }}</td>\n              <td style=\"padding:10px;border-bottom:1px solid #f1f5f9;\">{{ frappe.format(row.assigned_on, {'fieldtype': 'Datetime'}) if row.assigned_on else '\u2014' }}</td>\n              <td style=\"padding:10px;border-bottom:1px solid #f1f5f9;\">{{ frappe.format(row.due_date, {'fieldtype': 'Date'}) if row.due_date else '\u2014' }}</td>\n              <td style=\"padding:10px;border-bottom:1px solid #f1f5f9;\">{{ row.status or '\u2014' }}</td>\n            </tr>\n            {% endfor %}\n          </tbody>\n        </table>\n      </div>\n      {% endif %}\n\n      {% if doc.resolution_summary %}\n      <div style=\"margin-top:14px;padding:16px;border:1px solid #bbf7d0;border-radius:16px;background:#f0fdf4;\">\n        <div style=\"font-size:15px;font-weight:800;margin-bottom:10px;color:#166534;\">\u062e\u0644\u0627\u0635\u0629 \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629</div>\n        <div style=\"line-height:1.9;font-size:13px;\">{{ doc.resolution_summary }}</div>\n      </div>\n      {% endif %}\n\n      <div style=\"margin-top:16px;padding-top:14px;border-top:1px dashed #d1d5db;font-size:11px;color:#6b7280;text-align:center;\">\n        \u062a\u0645 \u0625\u0646\u0634\u0627\u0621 \u0647\u0630\u0627 \u0627\u0644\u0633\u062c\u0644 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0627\u064b \u0645\u0646 \u0645\u0646\u0635\u0629 \u0627\u0644\u064a\u0645\u0646 \u0644\u0644\u0634\u0643\u0627\u0648\u0649 \u0648\u0627\u0644\u062a\u0638\u0644\u0645\u0627\u062a\u060c \u0648\u064a\u0639\u062a\u0645\u062f \u0639\u0646\u062f \u0645\u0637\u0627\u0628\u0642\u062a\u0647 \u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0646\u0638\u0627\u0645.\n      </div>\n    </div>\n  </div>\n</div>\n",
